# Copy this file to ".env" and fill in your own values.

# Local MongoDB, or a free cluster from MongoDB Atlas (atlas.mongodb.com)
MONGO_URI=mongodb://127.0.0.1:27017/casanest

# Any long random string — used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_string


# The URL your frontend is served from (for CORS). Use * during local testing if unsure.
CLIENT_ORIGIN=http://localhost:5500
